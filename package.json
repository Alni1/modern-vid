{
  "name": "modern-vid",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prestart": "npm run build:player",
    "start": "node ./bin/www",
    "build": "npm run build:player",
    "build:player": "node player/build.mjs",
    "watch:player": "node player/build.mjs --watch",
    "typecheck:player": "tsc -p player/tsconfig.json",
    "retranscode": "node scripts/retranscode.js",
    "cleanup-legacy": "node scripts/cleanup-legacy.js",
    "previews": "node scripts/previews.js",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-rate-limiter": "^1.3.1",
    "express-session": "^1.18.1",
    "fluent-ffmpeg": "^2.1.3",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.15.1",
    "morgan": "~1.9.1",
    "multer": "^2.0.0",
    "uuidv7": "^1.0.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "eslint": "^9.27.0",
    "typescript": "^6.0.3"
  }
}
