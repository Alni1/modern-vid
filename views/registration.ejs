<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/head') %>
  <title><%= title %> | ModernVid</title>
</head>
<body style="margin:0;">
  <%- include('partials/header', { user: null, query: '' }) %>

  <main class="auth-page">
    <form action="/registration" method="POST" class="auth-card">
      <h1>Create an account</h1>
      <p class="auth-sub">Upload videos, comment and set up your own player.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="auth-error" role="alert"><%= error %></p>
      <% } %>
      <% if (typeof validationError !== 'undefined' && validationError) { %>
        <ul class="auth-error" role="alert">
          <% Object.values(validationError).forEach(function (errMsg) { %><li><%= errMsg %></li><% }); %>
        </ul>
      <% } %>

      <label for="login">Login</label>
      <input type="text" name="login" id="login" autocomplete="username" required
             minlength="3" maxlength="30" pattern="[A-Za-z0-9][A-Za-z0-9._\-]{2,29}" spellcheck="false" autocapitalize="none"
             aria-describedby="loginHint" placeholder="e.g. alex.konev"
             title="One word: Latin letters, digits, dots, underscores or hyphens (3–30 characters)"
             value="<%= typeof loginValue !== 'undefined' ? loginValue : '' %>">
      <p class="auth-hint" id="loginHint">One word for signing in: Latin letters, digits, <code>.</code> <code>_</code> <code>-</code></p>

      <label for="username">Display name</label>
      <input type="text" name="username" id="username" autocomplete="name" required maxlength="50"
             aria-describedby="nameHint" placeholder="e.g. Олексій Конєвіченко"
             value="<%= typeof usernameValue !== 'undefined' ? usernameValue : '' %>">
      <p class="auth-hint" id="nameHint">Shown on your channel and comments. Any language, spaces allowed.</p>

      <label for="password">Password</label>
      <input type="password" name="password" id="password" autocomplete="new-password" minlength="6" placeholder="At least 6 characters" required>

      <button type="submit" class="registerbtn">Sign up</button>
      <p class="auth-alt">Already have an account? <a href="/login">Log in</a></p>
    </form>
  </main>
</body>
</html>
