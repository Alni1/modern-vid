<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | ModernVid</title>
  <%- include('partials/head') %>
  <script type="module" src="/mvplayer/mvplayer.js"></script>
</head>
<%
  const compact = (n) => n >= 1e6 ? (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1).replace(/\.0$/, '') + 'K' : String(n || 0);
  const ago = (d) => {
    if (!d) return '';
    const sec = Math.max(1, Math.round((Date.now() - new Date(d).getTime()) / 1000));
    const units = [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]];
    for (const [name, size] of units) {
      const n = Math.floor(sec / size);
      if (n >= 1) return n + ' ' + name + (n > 1 ? 's' : '') + ' ago';
    }
    return 'just now';
  };
  const durationText = (s) => {
    if (!s) return '';
    s = Math.round(s);
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = String(s % 60).padStart(2, '0');
    return h ? h + ':' + String(m).padStart(2, '0') + ':' + sec : m + ':' + sec;
  };
  const initial = (name) => (name || '?').trim().charAt(0).toUpperCase();
  const owner = video && video.user ? video.user : null;
  const comments = video && video.comments ? video.comments : [];
  const me = user ? String(user._id) : null;
  const ownerId = owner ? String(owner._id) : null;
  const fullDate = (d) => d ? new Date(d).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '';
  const progress = Math.round(((video && video.processingProgress) || 0) * 100);
%>
<body>
  <%- include('partials/header', { user: typeof user !== 'undefined' ? user : null, query: '' }) %>

  <main class="watch">
    <div class="watch-main">
      <% if (playable && processing) { %>
        <div class="watch-placeholder" id="processingBox" data-video-id="<%= video._id %>">
          <div>
            <div class="watch-spinner" aria-hidden="true"></div>
            <p class="watch-placeholder-title">Preparing the video…</p>
            <p class="watch-placeholder-sub">It will start automatically in a moment.</p>
            <div class="watch-progress"><div id="processingFill" style="width: <%= progress %>%"></div></div>
            <p class="watch-placeholder-sub" id="processingText"><%= progress %>%</p>
          </div>
        </div>
      <% } else if (playable) { %>
        <mv-player id="my-player"
                   data-video-id="<%= video._id %>"
                   src="<%= hlsUrl || progressiveUrl %>"
                   <% if (hlsUrl) { %>fallback-src="<%= progressiveUrl %>"<% } %>
                   <% if (video.thumbnailUrl) { %>poster="<%= video.thumbnailUrl %>"<% } %>
                   <% if (thumbnailsUrl) { %>thumbnails="<%= thumbnailsUrl %>"<% } %>
                   resume-key="<%= video._id %>"
                   <% if (nextVideo) { %>next-url="<%= nextVideo.url %>" next-title="<%= nextVideo.title || 'Untitled' %>"<% } %>
                   <% if (subtitles.length) { %>subtitles="<%= JSON.stringify(subtitles) %>"<% } %>
                   <% if (chapters.length) { %>chapters="<%= JSON.stringify(chapters.map(function (c) { return { start: c.start, title: c.title }; })) %>"<% } %>
                   <% if (authorTheme) { %>author-theme="<%= JSON.stringify(authorTheme) %>"<% } %>
                   <% if (viewerPreset) { %>preset="<%= JSON.stringify(viewerPreset) %>"<% } %>></mv-player>
        <% if (hlsUrl && video.processingProgress !== undefined && video.processingProgress < 1) { %>
          <p class="watch-note">Higher qualities are being prepared (<%= progress %>%) and appear after a page reload.</p>
        <% } %>
      <% } else { %>
        <div class="watch-placeholder"><p class="watch-placeholder-title">This video is no longer available.</p></div>
      <% } %>

      <% if (video.hiddenAt) { %>
        <p class="watch-hidden" role="status">
          <strong>Hidden by moderators</strong><% if (video.hiddenReason) { %>: <%= video.hiddenReason %><% } %>.
          Only the author and moderators can see this video.
        </p>
      <% } %>
      <h1 class="watch-title"><%= video.title || 'Untitled' %></h1>

      <div class="watch-bar">
        <div class="watch-channel">
          <span class="watch-avatar" aria-hidden="true">
            <% if (owner && owner.avatarUrl) { %><img src="<%= owner.avatarUrl %>" alt="" /><% } else { %><%= initial(owner && owner.username) %><% } %>
          </span>
          <div>
            <p class="watch-channel-name"><% if (owner) { %><a href="/channel/<%= owner._id %>"><%= owner.username %></a><% } else { %>Unknown<% } %></p>
            <p class="watch-channel-sub"><span data-subscribers="<%= owner ? owner._id : '' %>"><%= subscribers %></span> <%= subscribers === 1 ? 'subscriber' : 'subscribers' %> · <%= channelVideos %> <%= channelVideos === 1 ? 'video' : 'videos' %></p>
          </div>
          <% if (owner && me !== String(owner._id)) { %>
            <button type="button" class="ch-btn ch-sub<%= subscribed ? ' is-on' : '' %>" data-subscribe="<%= owner._id %>" aria-pressed="<%= subscribed %>"><%= subscribed ? 'Subscribed' : 'Subscribe' %></button>
          <% } %>
        </div>
        <div class="watch-actions">
          <button type="button" class="watch-pill<%= liked ? ' is-on' : '' %>" data-like="<%= video._id %>" aria-pressed="<%= liked %>" title="I like this">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11v9H4v-9zM7 11l4-7a2 2 0 0 1 3 2l-1 4h5a2 2 0 0 1 2 2.3l-1.2 6A2 2 0 0 1 16.8 20H7"/></svg>
            <span data-likes><%= compact(video.likes || 0) %></span>
          </button>
          <button type="button" class="watch-pill" data-save="<%= video._id %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h12M4 11h12M4 16h7M18 13v8M14 17h8"/></svg>
            Save
          </button>
          <button type="button" class="watch-pill" id="shareBtn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
            Copy link
          </button>
          <% if (me && ownerId && me !== ownerId) { %>
            <button type="button" class="watch-pill" id="reportVideo" data-report="video" data-target="<%= video._id %>">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>
              Report
            </button>
          <% } %>
        </div>
      </div>

      <section class="watch-desc" id="description">
        <p class="watch-desc-meta">
          <strong><%= compact(video.views) %> views</strong> · <%= ago(video.uploadedAt) %>
          <% if (video.category) { %> · <a href="/search?category=<%= encodeURIComponent(video.category) %>">#<%= video.category %></a><% } %>
        </p>
        <% if (video.description) { %>
          <p class="watch-desc-text" id="descText"><%= video.description %></p>
          <button type="button" class="watch-more" id="descMore" hidden>Show more</button>
        <% } else { %>
          <p class="watch-desc-text watch-muted">No description.</p>
        <% } %>
        <% if (chapters.length) { %>
          <h3 class="watch-chapters-title">Chapters</h3>
          <ol class="watch-chapters">
            <% chapters.forEach(function (c) { %>
              <li><button type="button" data-seek="<%= c.start %>"><span class="watch-chapter-time"><%= c.time %></span> <%= c.title %></button></li>
            <% }) %>
          </ol>
        <% } %>
      </section>

      <section class="watch-comments" aria-labelledby="commentsTitle">
        <h2 id="commentsTitle"><span id="commentCount"><%= comments.length %></span> <span id="commentWord"><%= comments.length === 1 ? 'comment' : 'comments' %></span></h2>
        <% if (user && user.bannedUntil && new Date(user.bannedUntil) > new Date()) { %>
          <p class="comment-restricted">Your account is restricted<%= user.banReason ? ': ' + user.banReason : '' %>. You cannot comment until <%= new Date(user.bannedUntil).getFullYear() > 9000 ? 'the restriction is lifted' : fullDate(user.bannedUntil) %>.</p>
        <% } else if (user) { %>
          <form id="commentForm" class="comment-new" data-video-id="<%= video._id %>">
            <span class="watch-avatar watch-avatar-sm" aria-hidden="true">
              <% if (user.avatarUrl) { %><img src="<%= user.avatarUrl %>" alt="" /><% } else { %><%= initial(user.username) %><% } %>
            </span>
            <div class="comment-new-body">
              <textarea id="commentText" name="text" rows="1" maxlength="1000" placeholder="Add a comment…" aria-label="Add a comment" required></textarea>
              <div class="comment-new-actions" hidden>
                <span class="comment-hint">Ctrl + Enter to post <span class="comment-counter" id="commentCounter" hidden></span></span>
                <button type="button" class="site-btn site-btn-quiet" id="commentCancel">Cancel</button>
                <button type="submit" class="site-btn site-btn-primary" id="commentSubmit" disabled>Comment</button>
              </div>
            </div>
          </form>
        <% } else { %>
          <p class="comment-login"><a href="/login">Log in</a> to leave a comment.</p>
        <% } %>

        <ul class="comment-list" id="commentsList" data-me="<%= me || '' %>" data-owner="<%= ownerId || '' %>">
          <% comments.forEach(function (comment) {
               const cu = comment.user;
               const cuId = cu ? String(cu._id) : null;
               const canDelete = me && (me === cuId || me === ownerId || isModerator);
               const canReport = me && cuId && me !== cuId; %>
            <li class="comment<%= comment.hiddenAt ? ' is-hidden' : '' %>" data-id="<%= comment._id %>">
              <<%= cuId ? 'a href=/channel/' + cuId + ' tabindex=-1' : 'span' %> class="watch-avatar watch-avatar-sm" aria-hidden="true">
                <% if (cu && cu.avatarUrl) { %><img src="<%= cu.avatarUrl %>" alt="" /><% } else { %><%= initial(cu && cu.username) %><% } %>
              </<%= cuId ? 'a' : 'span' %>>
              <div class="comment-body">
                <p class="comment-head">
                  <% if (cuId) { %><a href="/channel/<%= cuId %>" class="comment-name<%= cuId === ownerId ? ' is-author' : '' %>"><%= cu.username %></a><% } else { %><strong class="comment-name">Deleted user</strong><% } %>
                  <% if (cuId && cuId === ownerId) { %><span class="comment-badge">Author</span><% } %>
                  <time datetime="<%= comment.createdAt ? new Date(comment.createdAt).toISOString() : '' %>" title="<%= fullDate(comment.createdAt) %>"><%= ago(comment.createdAt) %></time>
                </p>
                <% if (comment.hiddenAt) { %><p class="comment-hidden-note">Hidden by moderators<%= comment.hiddenReason ? ': ' + comment.hiddenReason : '' %>. Only you and moderators can see it.</p><% } %>
                <p class="comment-text"><%= comment.text %></p>
                <button type="button" class="comment-more" hidden>Read more</button>
              </div>
              <% if (canDelete || canReport) { %>
                <div class="comment-tools">
                  <% if (canReport) { %>
                    <button type="button" class="comment-tool comment-report" data-report="comment" aria-label="Report comment" title="Report comment"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg></button>
                  <% } %>
                  <% if (canDelete) { %>
                    <button type="button" class="comment-tool comment-delete" aria-label="Delete comment" title="Delete comment"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg></button>
                  <% } %>
                </div>
              <% } %>
            </li>
          <% }) %>
        </ul>
        <p class="comment-empty" id="noComments"<% if (comments.length) { %> hidden<% } %>>No comments yet. Be the first!</p>
      </section>
    </div>

    <aside class="watch-side" aria-label="Up next">
      <% if (playlist) { %>
        <section class="watch-playlist" aria-labelledby="plSideTitle">
          <div class="watch-playlist-head">
            <h2 id="plSideTitle"><a href="/playlist/<%= playlist.id %>"><%= playlist.title %></a></h2>
            <p class="watch-muted"><%= playlist.owner ? playlist.owner.username + ' · ' : '' %><%= playlist.index + 1 %> / <%= playlist.items.length %></p>
          </div>
          <ol class="watch-playlist-list">
            <% playlist.items.forEach(function (item, i) { %>
              <li<%= i === playlist.index ? ' class=is-current aria-current=true' : '' %>>
                <a href="/player/<%= item._id %>?list=<%= playlist.id %>" class="next-item">
                  <span class="pl-num"><%= i === playlist.index ? '▶' : i + 1 %></span>
                  <span class="next-thumb"><% if (item.thumbnailUrl) { %><img src="<%= item.thumbnailUrl %>" alt="" loading="lazy" /><% } %></span>
                  <span class="next-text"><span class="next-title"><%= item.title || 'Untitled' %></span><span class="next-meta"><%= item.user && item.user.username ? item.user.username : '' %></span></span>
                </a>
              </li>
            <% }) %>
          </ol>
        </section>
      <% } %>
      <h2>Up next</h2>
      <% if (recommendedVideos && recommendedVideos.length) { %>
        <ul class="next-list">
          <% recommendedVideos.forEach(function (rec) { %>
            <li>
              <a href="/player/<%= rec._id %>" class="next-item">
                <span class="next-thumb">
                  <% if (rec.thumbnailUrl) { %><img src="<%= rec.thumbnailUrl %>" alt="" loading="lazy" /><% } %>
                  <% if (durationText(rec.duration)) { %><span class="vcard-duration"><%= durationText(rec.duration) %></span><% } %>
                </span>
                <span class="next-text">
                  <span class="next-title"><%= rec.title || 'Untitled' %></span>
                  <span class="next-meta"><%= rec.user && rec.user.username ? rec.user.username : 'Unknown' %></span>
                  <span class="next-meta"><%= compact(rec.views) %> views · <%= ago(rec.uploadedAt) %></span>
                </span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="watch-muted">Nothing else yet.</p>
      <% } %>
    </aside>
  </main>

  <% if (me) { %>
    <dialog class="report-dialog" id="reportDialog" aria-labelledby="reportTitle">
      <form method="dialog" id="reportForm">
        <h2 id="reportTitle">Report</h2>
        <p class="report-sub" id="reportSub">What is wrong with it?</p>
        <fieldset class="report-reasons">
          <legend class="sr-only">Reason</legend>
          <% Object.keys(reportReasons).forEach(function (key) { %>
            <label><input type="radio" name="reason" value="<%= key %>" required> <%= reportReasons[key] %></label>
          <% }) %>
        </fieldset>
        <label class="report-note-label" for="reportNote">Details <span>(optional)</span></label>
        <textarea id="reportNote" name="note" maxlength="500" rows="3" placeholder="Anything that helps moderators"></textarea>
        <p class="report-error" id="reportError" role="alert" hidden></p>
        <div class="report-actions">
          <button type="button" class="site-btn site-btn-quiet" id="reportCancel">Cancel</button>
          <button type="submit" class="site-btn site-btn-primary" id="reportSubmit">Send report</button>
        </div>
      </form>
    </dialog>
  <% } %>
  <div class="site-toast" id="toast" role="status" hidden></div>
  <script src="/javascripts/watch.js" defer></script>
</body>
</html>
