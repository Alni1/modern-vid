<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | ModernVid</title>
  <%- include('partials/head') %>
  <script type="module" src="/mvplayer/mvplayer.js"></script>
</head>
<%
  const compact = (n) => n >= 1e6 ? (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1).replace(/\.0$/, '') + 'K' : String(n || 0);
  const ago = (d) => {
    if (!d) return '';
    const sec = Math.max(1, Math.round((Date.now() - new Date(d).getTime()) / 1000));
    const units = [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]];
    for (const [name, size] of units) {
      const n = Math.floor(sec / size);
      if (n >= 1) return n + ' ' + name + (n > 1 ? 's' : '') + ' ago';
    }
    return 'just now';
  };
  const durationText = (s) => {
    if (!s) return '';
    s = Math.round(s);
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = String(s % 60).padStart(2, '0');
    return h ? h + ':' + String(m).padStart(2, '0') + ':' + sec : m + ':' + sec;
  };
  const initial = (name) => (name || '?').trim().charAt(0).toUpperCase();
  const owner = video && video.user ? video.user : null;
  const comments = video && video.comments ? video.comments : [];
  const progress = Math.round(((video && video.processingProgress) || 0) * 100);
%>
<body>
  <%- include('partials/header', { user: typeof user !== 'undefined' ? user : null, query: '' }) %>

  <main class="watch">
    <div class="watch-main">
      <% if (playable && processing) { %>
        <div class="watch-placeholder" id="processingBox" data-video-id="<%= video._id %>">
          <div>
            <div class="watch-spinner" aria-hidden="true"></div>
            <p class="watch-placeholder-title">Preparing the video…</p>
            <p class="watch-placeholder-sub">It will start automatically in a moment.</p>
            <div class="watch-progress"><div id="processingFill" style="width: <%= progress %>%"></div></div>
            <p class="watch-placeholder-sub" id="processingText"><%= progress %>%</p>
          </div>
        </div>
      <% } else if (playable) { %>
        <mv-player id="my-player"
                   src="<%= hlsUrl || progressiveUrl %>"
                   <% if (hlsUrl) { %>fallback-src="<%= progressiveUrl %>"<% } %>
                   <% if (video.thumbnailUrl) { %>poster="<%= video.thumbnailUrl %>"<% } %>
                   <% if (thumbnailsUrl) { %>thumbnails="<%= thumbnailsUrl %>"<% } %>
                   <% if (authorTheme) { %>author-theme="<%= JSON.stringify(authorTheme) %>"<% } %>
                   <% if (viewerPreset) { %>preset="<%= JSON.stringify(viewerPreset) %>"<% } %>></mv-player>
        <% if (hlsUrl && video.processingProgress !== undefined && video.processingProgress < 1) { %>
          <p class="watch-note">Higher qualities are being prepared (<%= progress %>%) and appear after a page reload.</p>
        <% } %>
      <% } else { %>
        <div class="watch-placeholder"><p class="watch-placeholder-title">This video is no longer available.</p></div>
      <% } %>

      <h1 class="watch-title"><%= video.title || 'Untitled' %></h1>

      <div class="watch-bar">
        <div class="watch-channel">
          <span class="watch-avatar" aria-hidden="true">
            <% if (owner && owner.avatarUrl) { %><img src="<%= owner.avatarUrl %>" alt="" /><% } else { %><%= initial(owner && owner.username) %><% } %>
          </span>
          <div>
            <p class="watch-channel-name"><%= owner ? owner.username : 'Unknown' %></p>
            <p class="watch-channel-sub"><%= channelVideos %> <%= channelVideos === 1 ? 'video' : 'videos' %></p>
          </div>
        </div>
        <div class="watch-actions">
          <button type="button" class="watch-pill" id="shareBtn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
            Copy link
          </button>
        </div>
      </div>

      <section class="watch-desc" id="description">
        <p class="watch-desc-meta">
          <strong><%= compact(video.views) %> views</strong> · <%= ago(video.uploadedAt) %>
          <% if (video.category) { %> · <a href="/search?category=<%= encodeURIComponent(video.category) %>">#<%= video.category %></a><% } %>
        </p>
        <% if (video.description) { %>
          <p class="watch-desc-text" id="descText"><%= video.description %></p>
          <button type="button" class="watch-more" id="descMore" hidden>Show more</button>
        <% } else { %>
          <p class="watch-desc-text watch-muted">No description.</p>
        <% } %>
      </section>

      <section class="watch-comments" aria-labelledby="commentsTitle">
        <h2 id="commentsTitle"><span id="commentCount"><%= comments.length %></span> <%= comments.length === 1 ? 'comment' : 'comments' %></h2>
        <% if (user) { %>
          <form id="commentForm" class="comment-new" data-video-id="<%= video._id %>">
            <span class="watch-avatar watch-avatar-sm" aria-hidden="true">
              <% if (user.avatarUrl) { %><img src="<%= user.avatarUrl %>" alt="" /><% } else { %><%= initial(user.username) %><% } %>
            </span>
            <div class="comment-new-body">
              <textarea id="commentText" name="text" rows="1" maxlength="1000" placeholder="Add a comment…" aria-label="Add a comment" required></textarea>
              <div class="comment-new-actions" hidden>
                <button type="button" class="site-btn site-btn-quiet" id="commentCancel">Cancel</button>
                <button type="submit" class="site-btn site-btn-primary" id="commentSubmit" disabled>Comment</button>
              </div>
            </div>
          </form>
        <% } else { %>
          <p class="watch-muted comment-login"><a href="/login">Log in</a> to leave a comment.</p>
        <% } %>

        <ul class="comment-list" id="commentsList">
          <% comments.forEach(function (comment) { %>
            <li class="comment">
              <span class="watch-avatar watch-avatar-sm" aria-hidden="true">
                <% if (comment.user && comment.user.avatarUrl) { %><img src="<%= comment.user.avatarUrl %>" alt="" /><% } else { %><%= initial(comment.user && comment.user.username) %><% } %>
              </span>
              <div>
                <p class="comment-head"><strong><%= comment.user ? comment.user.username : 'User' %></strong> <span><%= ago(comment.createdAt) %></span></p>
                <p class="comment-text"><%= comment.text %></p>
              </div>
            </li>
          <% }) %>
        </ul>
        <% if (comments.length === 0) { %><p class="watch-muted" id="noComments">No comments yet. Be the first!</p><% } %>
      </section>
    </div>

    <aside class="watch-side" aria-label="Up next">
      <h2>Up next</h2>
      <% if (recommendedVideos && recommendedVideos.length) { %>
        <ul class="next-list">
          <% recommendedVideos.forEach(function (rec) { %>
            <li>
              <a href="/player/<%= rec._id %>" class="next-item">
                <span class="next-thumb">
                  <% if (rec.thumbnailUrl) { %><img src="<%= rec.thumbnailUrl %>" alt="" loading="lazy" /><% } %>
                  <% if (durationText(rec.duration)) { %><span class="vcard-duration"><%= durationText(rec.duration) %></span><% } %>
                </span>
                <span class="next-text">
                  <span class="next-title"><%= rec.title || 'Untitled' %></span>
                  <span class="next-meta"><%= rec.user && rec.user.username ? rec.user.username : 'Unknown' %></span>
                  <span class="next-meta"><%= compact(rec.views) %> views · <%= ago(rec.uploadedAt) %></span>
                </span>
              </a>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="watch-muted">Nothing else yet.</p>
      <% } %>
    </aside>
  </main>

  <div class="site-toast" id="toast" role="status" hidden></div>
  <script src="/javascripts/watch.js" defer></script>
</body>
</html>
