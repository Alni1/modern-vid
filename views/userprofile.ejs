<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | ModernVid</title>
  <%- include('partials/head') %>
  <link href="/stylesheets/profile.css" rel="stylesheet" />
  <script type="module" src="/mvplayer/mvplayer.js"></script>
</head>
<%
  const ct = (typeof channelTheme !== 'undefined' && channelTheme) || {};
  const pvSrc = typeof previewSrc !== 'undefined' ? previewSrc : null;
  const pvPoster = typeof previewPoster !== 'undefined' ? previewPoster : null;
  const videos = Array.isArray(user.videos) ? user.videos : [];
  const totalViews = videos.reduce((sum, v) => sum + (v.views || 0), 0);
  const accent = ct.accent || '#ff3d3d';
  const compact = (n) => n >= 1e6 ? (n / 1e6).toFixed(1).replace(/\.0$/, '') + 'M' : n >= 1e3 ? (n / 1e3).toFixed(1).replace(/\.0$/, '') + 'K' : String(n);
  const duration = (s) => {
    if (!s) return '';
    s = Math.round(s);
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = String(s % 60).padStart(2, '0');
    return h ? h + ':' + String(m).padStart(2, '0') + ':' + sec : m + ':' + sec;
  };
  const ago = (d) => {
    const sec = Math.max(1, Math.round((Date.now() - new Date(d).getTime()) / 1000));
    const units = [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]];
    for (const [name, size] of units) {
      const n = Math.floor(sec / size);
      if (n >= 1) return n + ' ' + name + (n > 1 ? 's' : '') + ' ago';
    }
    return 'just now';
  };
  const joined = user.timestamp ? new Date(user.timestamp).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' }) : null;
  const fonts = [
    ['System', 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif'],
    ['Serif', 'Georgia, "Times New Roman", serif'],
    ['Monospace', 'ui-monospace, Consolas, "Courier New", monospace'],
    ['Rounded', '"Trebuchet MS", "Segoe UI", Verdana, sans-serif'],
  ];
  const swatches = ['#ff3d3d', '#ff8a00', '#f5c400', '#22c55e', '#00b3ff', '#3d6bff', '#a855f7', '#ec4899'];
%>
<body class="pf-body" style="--pf-accent: <%= accent %>;">
  <%- include('partials/header', { user: user, query: typeof query !== 'undefined' ? query : '' }) %>

  <main class="pf">
    <!-- ============ Channel header ============ -->
    <section class="pf-hero" aria-label="Channel">
      <div class="pf-cover" aria-hidden="true"></div>
      <div class="pf-hero-body">
        <form action="/userprofile/avatar" method="POST" enctype="multipart/form-data" class="pf-avatar-form" id="avatarForm">
          <label class="pf-avatar" title="Change profile picture">
            <% if (user.avatarUrl) { %>
              <img src="<%= user.avatarUrl %>" alt="" id="avatarImg" />
            <% } else { %>
              <span class="pf-avatar-letter" id="avatarImg"><%= (user.username || '?').trim().charAt(0).toUpperCase() %></span>
            <% } %>
            <span class="pf-avatar-edit" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
            </span>
            <input type="file" name="avatar" accept="image/*" class="pf-visually-hidden avatar-input" aria-label="Change profile picture" />
          </label>
        </form>

        <div class="pf-identity">
          <h1 class="pf-name"><%= user.username %></h1>
          <p class="pf-handle">@<%= user.login %><% if (joined) { %> · Joined <%= joined %><% } %></p>
          <ul class="pf-stats">
            <li><strong><%= videos.length %></strong> <%= videos.length === 1 ? 'video' : 'videos' %></li>
            <li><strong><%= compact(totalViews) %></strong> <%= totalViews === 1 ? 'view' : 'views' %></li>
          </ul>
        </div>

        <div class="pf-hero-actions">
          <button type="button" class="pf-btn pf-btn-primary" data-open-upload>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
            Upload video
          </button>
        </div>
      </div>
    </section>

    <!-- ============ Tabs ============ -->
    <nav class="pf-tabs" role="tablist" aria-label="Profile sections">
      <button type="button" role="tab" class="pf-tab" id="tab-videos" aria-controls="panel-videos" data-tab="videos">
        Videos <span class="pf-count"><%= videos.length %></span>
      </button>
      <button type="button" role="tab" class="pf-tab" id="tab-theme" aria-controls="panel-theme" data-tab="theme">Player theme</button>
      <button type="button" role="tab" class="pf-tab" id="tab-account" aria-controls="panel-account" data-tab="account">Account</button>
    </nav>

    <!-- ============ Videos ============ -->
    <section class="pf-panel" role="tabpanel" id="panel-videos" aria-labelledby="tab-videos">
      <% if (videos.length === 0) { %>
        <div class="pf-empty">
          <div class="pf-empty-art" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9.5v5l4.5-2.5z"/></svg>
          </div>
          <h2>No videos yet</h2>
          <p>Upload your first video. It becomes available in a minute and higher qualities follow in the background.</p>
          <button type="button" class="pf-btn pf-btn-primary" data-open-upload>Upload video</button>
        </div>
      <% } else { %>
        <div class="pf-toolbar">
          <label class="pf-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
            <input type="search" id="videoFilter" placeholder="Find a video" aria-label="Find a video" />
          </label>
          <label class="pf-select">
            <span class="pf-visually-hidden">Sort videos</span>
            <select id="videoSort">
              <option value="new">Newest first</option>
              <option value="old">Oldest first</option>
              <option value="views">Most viewed</option>
            </select>
          </label>
        </div>

        <ul class="pf-grid" id="videoGrid">
          <% videos.slice().reverse().forEach(function (video) { %>
            <li class="pf-card" data-title="<%= (video.title || '').toLowerCase() %>"
                data-date="<%= new Date(video.uploadedAt).getTime() %>" data-views="<%= video.views || 0 %>">
              <a href="/player/<%= video._id %>" class="pf-thumb">
                <% if (video.thumbnailUrl) { %>
                  <img src="<%= video.thumbnailUrl %>" alt="" loading="lazy" />
                <% } else { %>
                  <span class="pf-thumb-empty"></span>
                <% } %>
                <% if (video.status === 'processing') { %>
                  <span class="pf-badge pf-badge-work">Processing <%= Math.round((video.processingProgress || 0) * 100) %>%</span>
                <% } else if (video.status === 'ready' && video.hls && video.hls.masterKey && video.processingProgress < 1) { %>
                  <span class="pf-badge pf-badge-work">HD in progress <%= Math.round(video.processingProgress * 100) %>%</span>
                <% } else if (video.status === 'failed') { %>
                  <span class="pf-badge pf-badge-warn" title="<%= video.processingError || '' %>">Original quality only</span>
                <% } %>
                <% if (duration(video.duration)) { %><span class="pf-duration"><%= duration(video.duration) %></span><% } %>
              </a>
              <div class="pf-card-body">
                <a href="/player/<%= video._id %>" class="pf-card-title" title="<%= video.title %>"><%= video.title || 'Untitled' %></a>
                <p class="pf-card-meta"><%= compact(video.views || 0) %> views · <%= ago(video.uploadedAt) %></p>
              </div>
              <div class="pf-card-actions">
                <button type="button" class="pf-icon-btn" data-copy="/player/<%= video._id %>" title="Copy link" aria-label="Copy link to <%= video.title %>">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
                </button>
                <form method="POST" action="/userprofile/video/delete/<%= video._id %>" data-confirm="Delete “<%= video.title %>”? This cannot be undone.">
                  <button type="submit" class="pf-icon-btn pf-icon-danger" title="Delete video" aria-label="Delete <%= video.title %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12"/></svg>
                  </button>
                </form>
              </div>
            </li>
          <% }); %>
        </ul>
        <p class="pf-no-match" id="noMatch" hidden>No videos match your search.</p>
      <% } %>
    </section>

    <!-- ============ Player theme ============ -->
    <section class="pf-panel" role="tabpanel" id="panel-theme" aria-labelledby="tab-theme" hidden>
      <div class="pf-theme">
        <form id="channelThemeForm" class="pf-card-box pf-theme-form">
          <h2>Player theme for your channel</h2>
          <p class="pf-muted">Viewers see this look on your videos. Anyone can still switch to their own look in the player settings.</p>

          <fieldset class="pf-field">
            <legend>Accent color</legend>
            <div class="pf-swatches">
              <% swatches.forEach(function (c) { %>
                <button type="button" class="pf-swatch" style="background: <%= c %>" data-swatch="<%= c %>" data-target="accent" aria-label="Accent <%= c %>"></button>
              <% }) %>
              <input type="color" name="accent" value="<%= ct.accent || '#ff3d3d' %>" aria-label="Custom accent color" />
            </div>
          </fieldset>

          <div class="pf-field-row">
            <label class="pf-field">
              <span>Panel color</span>
              <input type="color" name="background" value="<%= ct.background || '#000000' %>" />
            </label>
            <label class="pf-field">
              <span>Text and icons</span>
              <input type="color" name="foreground" value="<%= ct.foreground || '#ffffff' %>" />
            </label>
          </div>

          <label class="pf-field">
            <span>Panel opacity <output data-for="panelOpacity"></output></span>
            <input type="range" name="panelOpacity" min="0" max="1" step="0.05" value="<%= ct.panelOpacity ?? 0.6 %>" />
          </label>
          <label class="pf-field">
            <span>Corner radius <output data-for="radius"></output></span>
            <input type="range" name="radius" min="0" max="16" step="1" value="<%= ct.radius ?? 6 %>" />
          </label>

          <fieldset class="pf-field">
            <legend>Button size</legend>
            <div class="pf-segmented">
              <% [['compact', 'Compact'], ['normal', 'Normal'], ['large', 'Large']].forEach(function (o) { %>
                <label><input type="radio" name="controlSize" value="<%= o[0] %>" <%= (ct.controlSize || 'normal') === o[0] ? 'checked' : '' %> /><span><%= o[1] %></span></label>
              <% }) %>
            </div>
          </fieldset>

          <label class="pf-field">
            <span>Font</span>
            <span class="pf-select">
              <select name="fontFamily">
                <% fonts.forEach(function (f) { %>
                  <option value="<%= f[1] %>" <%= (ct.fontFamily || fonts[0][1]) === f[1] ? 'selected' : '' %>><%= f[0] %></option>
                <% }) %>
              </select>
            </span>
          </label>

          <div class="pf-form-actions">
            <button type="submit" class="pf-btn pf-btn-primary">Save theme</button>
            <button type="button" class="pf-btn pf-btn-ghost" id="channelThemeReset">Reset to default</button>
            <span class="pf-status" id="channelThemeStatus" role="status"></span>
          </div>
        </form>

        <div class="pf-card-box pf-preview">
          <div class="pf-preview-head">
            <h2>Preview</h2>
            <span class="pf-muted">Try the controls — nothing here changes your own settings.</span>
          </div>
          <mv-player id="themePreview" preview
                     <% if (pvSrc) { %>src="<%= pvSrc %>"<% } %>
                     <% if (pvPoster) { %>poster="<%= pvPoster %>"<% } %>
                     author-theme="<%= JSON.stringify(ct) %>"></mv-player>
          <% if (!pvSrc) { %><p class="pf-muted pf-preview-note">Upload a video to preview the theme with real playback.</p><% } %>
        </div>
      </div>
    </section>

    <!-- ============ Account ============ -->
    <section class="pf-panel" role="tabpanel" id="panel-account" aria-labelledby="tab-account" hidden>
      <div class="pf-account">
        <div class="pf-card-box">
          <h2>Profile</h2>
          <dl class="pf-details">
            <div><dt>Display name</dt><dd><%= user.username %></dd></div>
            <div><dt>Login</dt><dd><%= user.login %></dd></div>
            <% if (joined) { %><div><dt>Member since</dt><dd><%= joined %></dd></div><% } %>
          </dl>
          <form action="/userprofile/avatar" method="POST" enctype="multipart/form-data" class="pf-avatar-row">
            <% if (user.avatarUrl) { %>
              <img src="<%= user.avatarUrl %>" alt="" class="pf-avatar-small" />
            <% } else { %>
              <span class="pf-avatar-small pf-avatar-letter"><%= (user.username || '?').trim().charAt(0).toUpperCase() %></span>
            <% } %>
            <label class="pf-btn pf-btn-ghost">
              Change profile picture
              <input type="file" name="avatar" accept="image/*" class="pf-visually-hidden avatar-input" />
            </label>
          </form>
        </div>

        <div class="pf-card-box">
          <h2>Session</h2>
          <p class="pf-muted">Sign out of ModernVid on this device.</p>
          <form method="POST" action="/logout" class="pf-form-actions" style="margin-top: 12px;">
            <button type="submit" class="pf-btn pf-btn-ghost">Sign out</button>
          </form>
        </div>

        <div class="pf-card-box pf-danger">
          <h2>Delete account</h2>
          <p class="pf-muted">Your videos, comments and player settings are removed for good.</p>
          <form method="POST" action="/userprofile/deleteUser" data-confirm="Delete your account and all your videos? This cannot be undone.">
            <button type="submit" class="pf-btn pf-btn-danger">Delete my account</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ============ Upload dialog ============ -->
  <dialog class="pf-dialog" id="uploadDialog" aria-labelledby="uploadTitle">
    <form id="videoUploadForm" method="dialog" class="pf-upload">
      <div class="pf-dialog-head">
        <h2 id="uploadTitle">Upload video</h2>
        <button type="button" class="pf-icon-btn" data-close-upload aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <label class="pf-drop" id="dropZone">
        <input type="file" id="modalVideoFile" name="video" accept="video/*" required class="pf-visually-hidden" />
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
        <strong id="dropText">Drop a video here or click to choose</strong>
        <span class="pf-muted" id="dropHint">MP4, WebM, MOV… up to 1 GB</span>
      </label>

      <label class="pf-field">
        <span>Title</span>
        <input type="text" id="modalTitle" name="title" required maxlength="120" placeholder="Give your video a title" />
      </label>
      <label class="pf-field">
        <span>Description <em class="pf-muted">optional</em></span>
        <textarea id="modalDescription" name="description" rows="3" maxlength="2000" placeholder="Tell viewers about your video"></textarea>
      </label>
      <fieldset class="pf-field">
        <legend>Category</legend>
        <div class="pf-segmented">
          <label><input type="radio" name="category" value="Education" checked /><span>Education</span></label>
          <label><input type="radio" name="category" value="Entertainment" /><span>Entertainment</span></label>
        </div>
      </fieldset>

      <div class="pf-progress" id="uploadProgress" hidden>
        <div class="pf-progress-bar"><span id="uploadProgressBar"></span></div>
        <span id="uploadPercent">0%</span>
      </div>
      <p class="pf-status" id="uploadStatus" role="status"></p>

      <div class="pf-form-actions pf-dialog-actions">
        <button type="button" class="pf-btn pf-btn-ghost" data-close-upload>Cancel</button>
        <button type="submit" class="pf-btn pf-btn-primary" id="submitUploadBtn">Upload</button>
      </div>
    </form>
  </dialog>

  <div class="pf-toast" id="toast" role="status" hidden></div>

  <script src="/javascripts/profile.js" defer></script>
</body>
</html>
