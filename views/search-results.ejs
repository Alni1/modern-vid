<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/head') %>
  <title>Search Results - ModernVid</title>
</head>
<body style="margin:0;">

  <%# Include header - Assuming you have a partial for the header or copy it here %>
<%- include('partials/header', { user: typeof user !== 'undefined' ? user : null, query: typeof query !== 'undefined' ? query : '', category: typeof category !== 'undefined' ? category : '' }) %>

<main class="site-main">
  <h1 class="page-title"><%= query ? 'Results for “' + query + '”' : (category || 'Search results') %></h1>
  <p class="page-sub"><%= videos ? videos.length : 0 %> <%= videos && videos.length === 1 ? 'video' : 'videos' %><% if (query && category) { %> in <%= category %><% } %></p>
  <% if (videos && videos.length > 0) { %>
    <div class="vgrid">
      <% videos.forEach(function (video) { %><%- include('partials/video-card', { video: video }) %><% }) %>
    </div>
  <% } else { %>
    <p class="empty-state">No videos found. Try another search.</p>
  <% } %>
</main>

</body>
</html>
