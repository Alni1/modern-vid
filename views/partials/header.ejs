<%
  const hdrUser = typeof user !== 'undefined' && user ? user : null;
  const hdrQuery = typeof query !== 'undefined' && query ? query : '';
  const hdrCategory = typeof category !== 'undefined' && category ? category : '';
  const hdrStaff = hdrUser && (hdrUser.role === 'moderator' || hdrUser.role === 'admin');
  const hdrBanned = hdrUser && hdrUser.bannedUntil && new Date(hdrUser.bannedUntil) > new Date();
%>
<header class="site-header">
  <a href="/" class="site-logo" aria-label="ModernVid home">
    <span class="site-logo-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 7.5v9l7.5-4.5z"/></svg></span>
    <span class="site-logo-text">modern<b>vid</b></span>
  </a>

  <nav class="site-cats" aria-label="Categories">
    <a href="/search?category=Education" class="site-cat<%= hdrCategory === 'Education' ? ' is-active' : '' %>">Education</a>
    <a href="/search?category=Entertainment" class="site-cat<%= hdrCategory === 'Entertainment' ? ' is-active' : '' %>">Entertainment</a>
  </nav>

  <form action="/search" method="GET" class="site-search" role="search">
    <input type="search" name="q" placeholder="Search videos" aria-label="Search videos" value="<%= hdrQuery %>" />
    <button type="submit" aria-label="Search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>
    </button>
  </form>

  <div class="site-user">
    <div class="site-appearance">
      <button type="button" class="site-icon-btn" data-appearance-btn aria-haspopup="dialog" aria-expanded="false" title="Appearance" aria-label="Appearance">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-1-.9-1.5-1.8-1.2A6 6 0 0 1 13.2 4.8C13.5 3.9 13 3 12 3z"/></svg>
      </button>
      <div class="site-pop" role="dialog" aria-label="Appearance" hidden>
        <h3>Theme</h3>
        <div class="site-modes">
          <button type="button" data-mode="light" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>Light</button>
          <button type="button" data-mode="dark" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-1-.9-1.5-1.8-1.2A6 6 0 0 1 13.2 4.8C13.5 3.9 13 3 12 3z"/></svg>Dark</button>
          <button type="button" data-mode="system" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>System</button>
        </div>
        <h3>Accent color</h3>
        <div class="site-accents">
          <% [['', '#ff3d3d', 'Red (default)'], ['#f97316', '#f97316', 'Orange'], ['#16a34a', '#16a34a', 'Green'], ['#0ea5e9', '#0ea5e9', 'Sky'], ['#2563eb', '#2563eb', 'Blue'], ['#7c3aed', '#7c3aed', 'Violet'], ['#db2777', '#db2777', 'Pink']].forEach(function (c) { %>
            <button type="button" data-accent="<%= c[0] %>" style="background: <%= c[1] %>" aria-label="<%= c[2] %>" title="<%= c[2] %>" aria-pressed="false"></button>
          <% }) %>
        </div>
        <p class="site-pop-note">Saved in this browser. The video player has its own settings.</p>
      </div>
    </div>
    <% if (hdrUser) { %>
      <% if (hdrStaff) { %>
        <a href="/moderation" class="site-icon-btn site-staff" title="Moderation" aria-label="Moderation" style="position: relative;">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
          <span class="site-staff-count" id="modCount" hidden></span>
        </a>
      <% } %>
      <% if (hdrBanned) { %>
        <a href="/userprofile#account" class="site-flag" title="<%= hdrUser.banReason || 'Your account is restricted' %>">Restricted</a>
      <% } %>
      <a href="/userprofile#upload" class="site-btn site-btn-primary site-upload" title="Upload video">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
        <span>Upload</span>
      </a>
      <a href="/userprofile" class="site-avatar" title="Your channel" aria-label="Your channel">
        <% if (hdrUser.avatarUrl) { %>
          <img src="<%= hdrUser.avatarUrl %>" alt="" />
        <% } else { %>
          <span><%= (hdrUser.username || '?').trim().charAt(0).toUpperCase() %></span>
        <% } %>
      </a>
      <form method="POST" action="/logout" class="site-logout">
        <button type="submit" class="site-icon-btn" title="Sign out" aria-label="Sign out">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"/></svg>
        </button>
      </form>
    <% } else { %>
      <a href="/login" class="site-btn site-btn-ghost">Log in</a>
      <a href="/registration" class="site-btn site-btn-primary">Sign up</a>
    <% } %>
  </div>
</header>
