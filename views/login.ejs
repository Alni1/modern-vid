<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/head') %>
  <title><%= title %> | ModernVid</title>
</head>
<body style="margin:0;">
  <%- include('partials/header', { user: null, query: '' }) %>

  <main class="auth-page">
    <form action="/login" method="POST" class="auth-card">
      <h1>Welcome back</h1>
      <p class="auth-sub">Log in to upload videos and keep your player settings.</p>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="auth-error" role="alert"><%= error %></p>
      <% } %>

      <label for="login">Login</label>
      <input type="text" name="login" id="login" autocomplete="username" required
             value="<%= typeof loginValue !== 'undefined' ? loginValue : '' %>">

      <label for="password">Password</label>
      <input type="password" name="password" id="password" autocomplete="current-password" required>

      <button type="submit" class="registerbtn">Log in</button>
      <p class="auth-alt">No account yet? <a href="/registration">Sign up</a></p>
    </form>
  </main>
</body>
</html>
