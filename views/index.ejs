<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%- include('partials/head') %>
  <title><%= title || "ModernVid" %></title>
</head>
<body style="margin:0;">

<%- include('partials/header', { user: typeof user !== 'undefined' ? user : null, query: typeof query !== 'undefined' ? query : '' }) %>

<main class="site-main">
  <% if (typeof popular !== 'undefined' && popular.length) { %>
    <section class="home-section" aria-labelledby="popularTitle">
      <h1 class="page-title" id="popularTitle">Popular this week</h1>
      <div class="vgrid">
        <% popular.forEach(function (video) { %><%- include('partials/video-card', { video: video }) %><% }) %>
      </div>
    </section>
  <% } %>
  <section class="home-section" aria-labelledby="latestTitle">
    <% if (typeof popular !== 'undefined' && popular.length) { %>
      <h2 class="page-title" id="latestTitle">New videos</h2>
    <% } else { %>
      <h1 class="page-title" id="latestTitle">Latest videos</h1>
    <% } %>
    <% if (videos && videos.length > 0) { %>
      <div class="vgrid">
        <% videos.forEach(function (video) { %><%- include('partials/video-card', { video: video }) %><% }) %>
      </div>
    <% } else { %>
      <p class="empty-state">No videos uploaded yet.</p>
    <% } %>
  </section>
</main>

</body>
</html>