# Copy to .env and fill in. Values below marked "optional" have sensible defaults.

MONGODB_URL=mongodb+srv://user:password@cluster.example.mongodb.net/modernvid
SECRET_KEY=change-me

# Storage: local (default) keeps media in ./storage and serves it at /media
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./storage            # optional

# Storage: s3 — any S3-compatible bucket (Backblaze B2, Cloudflare R2, MinIO). See docs/DEPLOY.md.
# STORAGE_DRIVER=s3
# S3_BUCKET=modernvid
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com   # B2: the endpoint shown for the bucket
# S3_REGION=eu-central-003                                 # B2: the part after "s3." in the endpoint; R2: auto
# S3_ACCESS_KEY_ID=...                                     # B2: keyID of an application key
# S3_SECRET_ACCESS_KEY=...                                 # B2: applicationKey
# S3_MEDIA_MODE=redirect                 # optional: redirect (video from the bucket) | proxy (through the server)
# S3_PUBLIC_URL=                         # optional: public bucket / CDN URL instead of signed links
# S3_DIRECT_UPLOAD=on                    # optional: off = uploads go through the server
# S3_URL_TTL=3600                        # optional: lifetime of signed links, s

# Behind Cloudflare Tunnel / nginx (optional): real client addresses for rate limits
# TRUST_PROXY=loopback
# NODE_ENV=production                    # secure cookies (the site must be opened over https)

# Uploads (optional)
# MAX_UPLOAD_MB=2048                     # maximum size of an uploaded video, MB (2 GB)

# Transcoding (optional)
# TRANSCODE_ENCODER=auto                 # auto | nvenc | cpu (auto = NVIDIA GPU if available)
# TRANSCODE_PRESET=veryfast              # libx264 preset: ultrafast, superfast, veryfast, faster, fast, medium
# NVENC_PRESET=fast                      # h264_nvenc preset
# FFMPEG_PATH=ffmpeg                     # use a system FFmpeg (e.g. installed with winget) instead of the bundled 4.1
# FFPROBE_PATH=ffprobe
# TRANSCODE_HWDECODE=off                 # disable GPU decoding (-hwaccel auto)
# TRANSCODE_WORKER=off                   # disable the in-process transcoding worker
